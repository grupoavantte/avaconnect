# Token do administrador Avantte (acesso total ao painel). Gere um valor longo e aleatório.
ADMIN_TOKEN=
# Chave da API da Anthropic (Claude). Sem ela, a IA roda em modo demonstração.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Opcional: modelo mais forte só para o plano Premium
ANTHROPIC_MODEL_PREMIUM=
# WhatsApp Cloud API (Meta)
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_GRAPH_VERSION=v21.0
# Caminho do banco SQLite (no Render, aponte para o disco persistente)
DB_PATH=./data/ava-connect.db
PORT=3000
