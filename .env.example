# Token do administrador Avantte (acesso total ao painel). Gere um valor longo e aleatório.
ADMIN_TOKEN=
# Chave da API da Anthropic (Claude). Sem ela, a IA roda em modo demonstração.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Opcional: modelo mais forte só para o plano Premium
ANTHROPIC_MODEL_PREMIUM=
# WhatsApp Cloud API (Meta)
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_GRAPH_VERSION=v21.0
# Caminho do banco SQLite (no Render, aponte para o disco persistente)
DB_PATH=./data/ava-connect.db
PORT=3000
# Pagamentos (Asaas). A chave global vale só para a empresa da Avantte (ASAAS_TENANT_ID, padrão 1).
# Cada empresa cliente cadastra a própria chave no painel (Vendas → Configuração), e o dinheiro cai na conta dela.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_TENANT_ID=1
# E-mail das propostas (resend.com). Sem chave, o envio é simulado no log.
RESEND_API_KEY=
EMAIL_FROM=vendas@grupoavantte.com.br
# Endereço público (links de proposta e pagamento). No Render é preenchido sozinho.
PUBLIC_URL=
# Cadência de follow-up em minutos (padrões: proposta D+1, D+3, D+6; pagamento D+1, D+3; conversa parada 22h)
VENDAS_FOLLOWUP_MIN=1440,4320,8640
VENDAS_LEMBRETE_PGTO_MIN=1440,4320
VENDAS_REENGAJAR_MIN=1320
# Plataforma: e-mail do primeiro usuário da Avantte (recebe o link para criar a senha no log de inicialização)
PLATAFORMA_EMAIL=contato@grupoavantte.com.br
PLATAFORMA_NOME=Walci Júnior
# Site público: número do WhatsApp comercial da Avantte (com DDI). Se vazio, usa o número principal da empresa Avantte.
SITE_WHATSAPP=
# Dias de tolerância antes de pausar um cliente com mensalidade atrasada
INADIMPLENCIA_DIAS=10
# Transcrição de áudio (API compatível com OpenAI). Padrão: Groq Whisper (barato). Para OpenAI: TRANSCRICAO_URL=https://api.openai.com/v1/audio/transcriptions e TRANSCRICAO_MODELO=whisper-1
TRANSCRICAO_API_KEY=
TRANSCRICAO_URL=https://api.groq.com/openai/v1/audio/transcriptions
TRANSCRICAO_MODELO=whisper-large-v3
# Conexão do WhatsApp pelo botão da Meta (Cadastro incorporado). Exige o app da Avantte como Tech Provider na Meta.
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=

# Plano anual: quantas mensalidades o cliente paga para ter 12 meses (padrão 10 = 2 meses grátis)
AVA_ANUAL_MESES=10
AVA_GARANTIA_DIAS=30
